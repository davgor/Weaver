{
  "name": "@weaver/electron-aivn",
  "version": "0.22.0",
  "private": true,
  "description": "AI Visual Novel game UI — Tell-a-Story → VN play on Weaver engines",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node ../../scripts/electron-postinstall.mjs",
    "predev": "npm run build -w @weaver/electron-ui --if-present",
    "dev": "electron-vite dev",
    "prebuild": "npm run build -w @weaver/electron-ui --if-present",
    "build": "electron-vite build",
    "pretypecheck": "npm run build -w @weaver/electron-ui --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@weaver/action-engine": "*",
    "@weaver/character-engine": "*",
    "@weaver/civilization-engine": "*",
    "@weaver/combat-engine": "*",
    "@weaver/dungeon-engine": "*",
    "@weaver/weather-engine": "*",
    "@weaver/dm-engine": "*",
    "@weaver/electron-ui": "*",
    "@weaver/enemy-engine": "*",
    "@weaver/item-engine": "*",
    "@weaver/llm-engine": "*",
    "@weaver/narration-engine": "*",
    "@weaver/npc-engine": "*",
    "@weaver/quest-engine": "*",
    "@weaver/regional-engine": "*",
    "@weaver/world-engine": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "42.7.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.davgor.weaver.aivn",
    "productName": "AI Visual Novel",
    "executableName": "AI-Visual-Novel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
