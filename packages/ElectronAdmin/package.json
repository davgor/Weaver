{
  "name": "@weaver/electron-admin",
  "version": "0.9.0",
  "private": true,
  "description": "AI ADMIN panel for app/LLM metrics, test functions, and DEV tooling",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node ../../scripts/electron-postinstall.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run package:win",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@weaver/action-engine": "*",
    "@weaver/character-engine": "*",
    "@weaver/civilization-engine": "*",
    "@weaver/combat-engine": "*",
    "@weaver/dungeon-engine": "*",
    "@weaver/dm-engine": "*",
    "@weaver/enemy-engine": "*",
    "@weaver/item-engine": "*",
    "@weaver/llm-engine": "*",
    "@weaver/narration-engine": "*",
    "@weaver/npc-engine": "*",
    "@weaver/regional-engine": "*",
    "@weaver/world-engine": "*",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "42.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.davgor.weaver.admin",
    "productName": "AI ADMIN",
    "executableName": "AI-ADMIN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "davgor",
      "repo": "Weaver",
      "channel": "ai-admin"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "artifactName": "AI-ADMIN-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AI-ADMIN-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "AI-ADMIN-${version}-${arch}.${ext}"
    }
  }
}
