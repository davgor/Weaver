{
  "name": "@weaver/narration-engine",
  "version": "0.1.0",
  "private": true,
  "description": "LLM story invention validated against engine data",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "terminology:check": "npm run build && node scripts/terminology-check.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@weaver/llm-engine": "*",
    "@weaver/npc-engine": "*",
    "typescript": "^5.5.2"
  }
}
